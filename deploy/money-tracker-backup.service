[Unit]
Description=Money Tracker: pg_dump into /var/backups/money-tracker (keeps newest 8)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/opt/money-tracker/api/deploy/pg-dump.sh
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/money-tracker
