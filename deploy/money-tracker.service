[Unit]
Description=Money Tracker (API + frontend, LAN only)
After=network-online.target postgresql.service
Wants=network-online.target
# A crash loop must end in "failed" (and trigger OnFailure= alerts, see
# deploy/notify/), not restart forever: 5 failed starts in 10 min.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
User=money
WorkingDirectory=/opt/money-tracker/api
EnvironmentFile=/etc/money-tracker.env
# Keep UTC, as on Render: DATE columns become JS Dates at local midnight,
# so a non-UTC zone would shift dates by a day in summer.
Environment=TZ=UTC NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
# Readiness: the unit is "active" only once /health answers (else the start fails
# and Restart= applies). $$ = a literal $ for the shell.
ExecStartPost=/bin/sh -c 'for i in $$(seq 30); do curl -fsS -o /dev/null "http://127.0.0.1:$${PORT:-3000}/health" && exit 0; sleep 1; done; echo "money-tracker: /health not OK after 30s" >&2; exit 1'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
